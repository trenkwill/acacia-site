---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import PageHero from "../components/sections/PageHero.astro";
import EditorialBlocks from "../components/sections/EditorialBlocks.astro";
import CtaBand from "../components/sections/CtaBand.astro";

const page = await getEntry("pages", "acacia");
if (!page) throw new Error("Missing pages/acacia.md");
const d = page.data;
---

<BaseLayout
  title={d.title}
  description={d.seo_description}
  screenLabel={d.screen_label}
>
  {d.page_hero && <PageHero {...d.page_hero} />}
  {d.blocks && <EditorialBlocks blocks={d.blocks} />}
  {d.cta_band && <CtaBand {...d.cta_band} />}
</BaseLayout>
