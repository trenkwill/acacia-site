---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import settings from "../data/settings.json";
import PageHero from "../components/sections/PageHero.astro";

const page = await getEntry("pages", "contact");
if (!page) throw new Error("Missing pages/contact.md");
const d = page.data;
---

<BaseLayout
  title={d.title}
  description={d.seo_description}
  screenLabel={d.screen_label}
>
  {d.page_hero && <PageHero {...d.page_hero} />}

  <section class="section">
    <div class="wrap">
      <div class="contact-layout">
        <div class="reveal">
          <p class="eyebrow eyebrow--forest">Écrivez-nous</p>
          <h2 class="h2" style="margin-top:12px;">Envoyez-nous un message</h2>
          <div class="form-success" id="form-success">
            <b>Merci, votre message a bien été envoyé.</b><br />
            Nous vous répondrons rapidement.
          </div>
          <form
            class="contact-form"
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/contact?success=1"
            style="margin-top:34px;"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p style="position:absolute;left:-9999px;">
              <label>Ne pas remplir : <input name="bot-field" /></label>
            </p>
            <div class="form-grid">
              <div class="form-row">
                <label for="name">Nom *</label>
                <input type="text" id="name" name="name" required />
              </div>
              <div class="form-row">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" required />
              </div>
            </div>
            <div class="form-grid">
              <div class="form-row">
                <label for="phone">Téléphone</label>
                <input type="tel" id="phone" name="phone" />
              </div>
              <div class="form-row">
                <label for="subject">Sujet *</label>
                <select id="subject" name="subject" required>
                  <option value="">— Sélectionnez —</option>
                  <option value="info">Demande d'information</option>
                  <option value="sourcing">Approvisionnement en acacia</option>
                  <option value="technical">Question technique</option>
                  <option value="partnership">Partenariat</option>
                  <option value="other">Autre</option>
                </select>
              </div>
            </div>
            <div class="form-row">
              <label for="message">Message *</label>
              <textarea id="message" name="message" rows="6" required></textarea>
            </div>
            <button type="submit" class="btn">
              Envoyer le message <span class="arrow">→</span>
            </button>
            <p class="form-note">* Champs obligatoires</p>
          </form>
        </div>

        <div class="reveal">
          <p class="eyebrow">Coordonnées</p>
          <h2 class="h2" style="margin-top:12px; margin-bottom:28px;">
            Nous joindre
          </h2>

          <div class="info-card">
            <div class="info-card__head">{settings.contact_main.label}</div>
            <div class="info-card__row">
              <span>Contact principal</span>{settings.contact_main.person}
            </div>
            <div class="info-card__row">
              <span>Téléphone</span>
              <a href={settings.contact_main.phone_link}>
                {settings.contact_main.phone}
              </a>
            </div>
            <div class="info-card__row">
              <span>Email</span>
              <a href={`mailto:${settings.contact_main.email}`}>
                {settings.contact_main.email}
              </a>
            </div>
          </div>

          <div class="info-card">
            <div class="info-card__head">
              {settings.contact_technical.label}
            </div>
            <div class="info-card__row">
              <span>Référent</span>{settings.contact_technical.person}
            </div>
            <div class="info-card__row">
              <span>Email</span>
              <a href={`mailto:${settings.contact_technical.email}`}>
                {settings.contact_technical.email}
              </a>
            </div>
            <p class="info-card__note">
              {settings.contact_technical.note}
            </p>
          </div>

          <div class="info-card">
            <div class="info-card__head">Notre mission</div>
            <p class="info-card__note" style="margin-top:0;">
              {settings.mission_text}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
