---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import settings from "../data/settings.json";
import ContactForm from "../components/ContactForm.astro";
import ContactCard from "../components/ContactCard.astro";

const page = await getEntry("pages", "contact");

const success = Astro.url.searchParams.get("success") === "1";
---

<BaseLayout
  title={page?.data.title ?? "Contact"}
  description={page?.data.seo_description}
>
  <div class="page-header">
    <h1>{page?.data.hero_title ?? "Contact"}</h1>
    <p class="lead">{page?.data.lead ?? "Nous sommes à votre écoute"}</p>
  </div>

  <section class="content-section">
    <div class="container">
      <div class="contact-layout">
        <div class="contact-form-container">
          <h2>Envoyez-nous un message</h2>

          {
            success && (
              <p class="form-success">
                Merci, votre message a bien été envoyé. Nous vous répondrons
                rapidement.
              </p>
            )
          }

          <ContactForm />
        </div>

        <div class="contact-info-container">
          <h2>Coordonnées</h2>

          <ContactCard heading={settings.contact_main.label}>
            <div class="contact-item">
              <strong>Contact principal :</strong><br />
              {settings.contact_main.person}
            </div>
            <div class="contact-item">
              <strong>Téléphone :</strong><br />
              <a href={settings.contact_main.phone_link}>
                {settings.contact_main.phone}
              </a>
            </div>
            <div class="contact-item">
              <strong>Email :</strong><br />
              <a href={`mailto:${settings.contact_main.email}`}>
                {settings.contact_main.email}
              </a>
            </div>
          </ContactCard>

          <ContactCard heading={settings.contact_technical.label}>
            <div class="contact-item">
              <strong>{settings.contact_technical.person}</strong><br />
              <a href={`mailto:${settings.contact_technical.email}`}>
                {settings.contact_technical.email}
              </a>
            </div>
            <p class="note">{settings.contact_technical.note}</p>
          </ContactCard>

          <ContactCard heading="Notre mission">
            <p>{settings.mission_text}</p>
          </ContactCard>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
