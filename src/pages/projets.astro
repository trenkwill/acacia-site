---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projets Industriels"
  description="Galerie de projets industriels et architecturaux réalisés en Acacia Robinia."
>
  <h1 class="page-title">Projets Industriels en Acacia</h1>

  <div class="content-section narrow-container">
    <div class="product-grid">
      {
        projects.map((entry) => (
          <ProjectCard
            title={entry.data.title}
            image={entry.data.image}
            description={entry.data.description}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
