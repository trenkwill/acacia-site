---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";

const page = await getEntry("pages", "architects");
if (!page) throw new Error("Page architects introuvable");
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.seo_description}>
  <div class="page-header">
    <h1>{page.data.hero_title ?? page.data.title}</h1>
    {page.data.lead && <p class="lead">{page.data.lead}</p>}
  </div>

  <section class="content-section">
    <div class="container markdown-content">
      <Content />

      <div class="cta-box">
        <h3>Intéressé par l'acacia pour vos projets ?</h3>
        <a href="/contact" class="btn btn-primary">Contactez-nous</a>
      </div>
    </div>
  </section>
</BaseLayout>
