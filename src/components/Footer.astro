---
import settings from "../data/settings.json";

const year = 2026;
---

<footer class="site-footer">
  <div class="wrap site-footer__top">
    <div class="footer-brand">
      <div class="footer-brand__name">
        {settings.brand_name_a} <b>{settings.brand_name_b}</b>
      </div>
      <p>{settings.footer_blurb}</p>
    </div>
    <div class="footer-col">
      <div class="footer-col__title">Navigation</div>
      <a href="/association">L'Association</a>
      <a href="/acacia">L'Acacia</a>
      <a href="/projets">Projets industriels</a>
      <a href="/produits">Nos produits</a>
      <a href="/architectes">Architectes</a>
    </div>
    <div class="footer-col">
      <div class="footer-col__title">Contact</div>
      <p>
        {settings.contact_address.line1}<br />
        {settings.contact_address.line2}<br />
        {settings.contact_address.zip_city}<br />
        {settings.contact_address.country}
      </p>
      <a href={settings.contact_main.phone_link}>{settings.contact_main.phone}</a>
      <a href={`mailto:${settings.footer_email}`}>{settings.footer_email}</a>
    </div>
  </div>
  <div class="wrap site-footer__bottom">
    <span>© {year} {settings.site_title}</span>
    <span>{settings.footer_credits}</span>
  </div>
</footer>
