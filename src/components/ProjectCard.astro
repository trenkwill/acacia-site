---
interface Props {
  title: string;
  image: string;
  description: string;
  alt?: string;
}

const { title, image, description, alt } = Astro.props;
---

<div class="product-card">
  <img src={image} class="product-image" alt={alt ?? title} />
  <div class="product-info">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</div>
