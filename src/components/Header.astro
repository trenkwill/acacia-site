---
import settings from "../data/settings.json";
import Nav from "./Nav.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="brand" aria-label={`Accueil — ${settings.site_title}`}>
      <img class="brand__logo" src={settings.logo} alt="" />
      <span class="brand__mark">
        <span class="brand__name">
          {settings.brand_name_a} <b>{settings.brand_name_b}</b>
        </span>
        <span class="brand__sub">{settings.brand_sub}</span>
      </span>
    </a>
    <button class="nav-toggle" aria-label="Menu"><span></span></button>
    <Nav currentPath={currentPath} />
  </div>
</header>
