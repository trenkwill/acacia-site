---
import settings from "../data/settings.json";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(itemUrl: string, current: string): boolean {
  if (itemUrl === "/") return current === "/" || current === "";
  return current === itemUrl || current.startsWith(itemUrl + "/");
}
---

<nav class="nav" aria-label="Navigation principale">
  {
    settings.nav_items.map((item) => (
      <a
        href={item.url}
        class:list={["nav__link", { "is-active": isActive(item.url, currentPath) }]}
      >
        {item.label}
      </a>
    ))
  }
</nav>
