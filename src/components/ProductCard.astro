---
interface Props {
  title: string;
  image: string;
  alt?: string;
  imageStyle?: string;
}

const { title, image, alt = "Produit Acacia", imageStyle } = Astro.props;
---

<div class="product-card">
  {
    imageStyle ? (
      <img
        src={image}
        class="product-image"
        alt={alt}
        style={imageStyle}
      />
    ) : (
      <img src={image} class="product-image" alt={alt} />
    )
  }
  <div class="product-info">
    {title && <p class="product-title"><strong>{title}</strong></p>}
    <slot />
  </div>
</div>
